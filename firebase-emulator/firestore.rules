rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /deliveryNotifications/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.event_id == eventId
        && request.auth.token.token_use == 'delivery_notification'
        && request.time < timestamp.value(request.auth.token.expires_at * 1000);
    }
  }
}
